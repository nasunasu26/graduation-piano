<% solfege_map = {
  "C" => "ド",
  "D" => "レ",
  "E" => "ミ",
  "F" => "ファ",
  "G" => "ソ",
  "A" => "ラ",
  "B" => "シ",
} %>

<div class="free-play-container" data-controller="free-play">
  <h1>自由演奏モード</h1>

  <div class="piano-scroll">
    <div class="piano">
      <!-- ===== 黒鍵 ===== -->
      <div class="black-keys">
        <% {
        # Octave 3
        "C#3"=>"2", "D#3"=>"4", "F#3"=>"7", "G#3"=>"9", "A#3"=>"-",
        # Octave 4
        "C#4"=>"w", "D#4"=>"r", "F#4"=>"u", "G#4"=>"o", "A#4"=>"@",
        # Octave 5
        "C#5"=>"s", "D#5"=>"f", "F#5"=>"j", "G#5"=>"l", "A#5"=>":"
      }.each do |note, key| %>
          <button
            type="button"
            class="key black"
            data-note="<%= note %>"
            data-action="
              mousedown->free-play#down
              mouseup->free-play#up
              mouseleave->free-play#up
              touchstart->free-play#down
              touchend->free-play#up
            "
          >
            <span class="key-label"><%= key %></span>
          </button>
        <% end %>
      </div>
      <!-- ===== 白鍵 ===== -->
      <div class="white-keys">
        <% {
    # Octave 3（低）
    "C3"=>"1","D3"=>"3","E3"=>"5","F3"=>"6","G3"=>"8","A3"=>"0","B3"=>"^",

    # Octave 4（中）
    "C4"=>"q","D4"=>"e","E4"=>"t","F4"=>"y","G4"=>"i","A4"=>"p","B4"=>"[",

    # Octave 5（高）
    "C5"=>"a","D5"=>"d","E5"=>"g","F5"=>"h","G5"=>"k","A5"=>" ; ","B5"=>"]"

  }.each do |note, key| %>

          <button
            type="button"
            class="key white"
            data-note="<%= note %>"
            data-action="
              mousedown->free-play#down
              mouseup->free-play#up
              mouseleave->free-play#up
              touchstart->free-play#down
              touchend->free-play#up
            "
          >

            <span class="solfege-label">
              <%= solfege_map[note[0]] %>
            </span>

            <span class="key-label">
              <%= key.strip %>
            </span>

          </button>

        <% end %>

      </div>
    </div>
  </div>

  <div class="display-settings">

    <div class="display-card">
      <div class="display-card-text">
        <p class="display-card-main">
          ドレミ表示
        </p>
        <p class="display-card-sub">
          鍵盤にドレミを表示します
        </p>
      </div>

      <label class="switch">
        <input type="checkbox" checked data-action="change->free-play#toggleSolfege">
        <span class="slider"></span>
      </label>
    </div>

    <div class="display-card">
      <div class="display-card-text">
        <p class="display-card-main">
          キーボード表示
        </p>
        <p class="display-card-sub">
          PCキーボード対応キーを表示します
        </p>
      </div>

      <label class="switch">
        <input type="checkbox" checked data-action="change->free-play#toggleKeyboard">
        <span class="slider"></span>
      </label>
    </div>

  </div>

  <div class="back-link">
    <%= link_to "トップに戻る", root_path %>
  </div>

</div>

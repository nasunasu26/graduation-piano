        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>
      <button class="key black" data-note="A#4"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>

      <span class="octave-gap"></span>

      <!-- Octave 5 -->
      <button class="key black" data-note="C#5"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>
      <button class="key black" data-note="D#5"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>
      <span class="black-gap"></span>
      <button class="key black" data-note="F#5"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>
      <button class="key black" data-note="G#5"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>
      <button class="key black" data-note="A#5"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>
    </div>

    <!-- ===== 白鍵 ===== -->
    <div class="white-keys">
      <!-- Octave 3 -->
      <button class="key white" data-note="C3"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>
      <button class="key white" data-note="D3"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>
      <button class="key white" data-note="E3"

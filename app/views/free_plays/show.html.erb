<div class="free-play-container" data-controller="free-play">
  <h1>自由演奏モード</h1>

  <div class="back-link">
    <%= link_to "← スタート画面に戻る", root_path %>
  </div>

  <div class="piano">
    <!-- ===== 黒鍵 ===== -->
    <div class="black-keys">
      <!-- Octave 3 -->
      <button class="key black" data-note="C#3"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>
      <button class="key black" data-note="D#3"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>
      <span class="black-gap"></span>
      <button class="key black" data-note="F#3"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>
      <button class="key black" data-note="G#3"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>
      <button class="key black" data-note="A#3"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>

      <span class="octave-gap"></span>

      <!-- Octave 4 -->
      <button class="key black" data-note="C#4"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>
      <button class="key black" data-note="D#4"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>
      <span class="black-gap"></span>
      <button class="key black" data-note="F#4"
        data-action="mousedown->free-play#down mouseup->free-play#up mouseleave->free-play#up"></button>

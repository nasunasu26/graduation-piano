<div
  class="learn-page"
  data-controller="play-history-list"
>

  <h1 class="learn-title">曲を少し覚えるモード</h1>

  <div class="learn-description">
    曲の一部を聴いて、同じように弾いてみることができます。<br>
    ☆を押すとお気に入りに登録され、もう一度押すと解除されます。
  </div>

  <div
    class="play-summary"
    data-play-history-list-target="summary"
  >
  </div>

  <div class="learn-controls">

  <div class="filter-box">

    <select id="favorite-filter">
      <option selected disabled>絞り込み</option>
      <option value="all">
        すべて
      </option>

    <option value="favorite">
      お気に入り
    </option>
  </select>

  </div>


  <div class="sort-box">

    <select onchange="location = this.value;">

  <option selected disabled>
    並び替え
  </option>

  <option value="/learns">
    登録順
  </option>

  <option value="/learns?sort=title"
    <%= "selected" if params[:sort] == "title" %>>
    曲名順
  </option>

  <option value="/learns?sort=composer"
    <%= "selected" if params[:sort] == "composer" %>>
    作曲者順
  </option>

</select>
  </div>
  </div>

<div class="learn-song-list">

  <% @songs.each do |song| %>

  <div class="learn-song-link"
    data-favorite="false"
    data-song-id="<%= song.id %>"
    data-song-title="<%= song.title %>"
    data-song-slug="<%= song.slug %>">

    <%= link_to learn_path(song.slug) do %>

      <div class="song-info">

        <div class="song-title-row">

          <span class="song-title">
            <%= song.title %>
          </span>

        </div>

        <span class="song-composer">
          <%= song.composer %>
        </span>

      </div>

      <div class="song-actions">

        <span class="favorite-star">☆</span>

        <span>＞</span>

      </div>

    <% end %>

  </div>

<% end %>

</div>

  <button
    id="pagetop"
    class="pagetop-btn"
    aria-label="ページトップへ戻る">
  </button>

  <div class="back-link">
    <%= link_to "トップに戻る", root_path %>
  </div>

</div>

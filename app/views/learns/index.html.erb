<div class="learn-page">

  <h1 class="learn-title">曲を少し覚えるモード</h1>

  <div class="sort-box">

    <select onchange="location = this.value;">
      <option value="/learns">並び替え</option>

      <option value="/learns?sort=title"
        <%= "selected" if params[:sort] == "title" %>>
        曲名順
      </option>

      <option value="/learns?sort=composer"
        <%= "selected" if params[:sort] == "composer" %>>
        作曲者順
      </option>
    </select>

  </div>

  <div class="learn-song-list">

    <% @songs.each do |song| %>

      <div class="learn-song-link">
        <%= link_to learn_path(song.slug) do %>
          <div class="song-info">

          <span class="song-title">
            <%= song.title %>
          </span>

          <span class="song-composer">
            <%= song.composer %>
          </span>
        </div>
        <span>＞</span>
      <% end %>

    </div>

  <% end %>

</div>

  <div class="back-link">
    <%= link_to "トップに戻る", root_path %>
  </div>

</div>

<div class="clear-page">

  <p class="clear-title">
    おめでとうございます！
  </p>

  <p class="clear-symbol">
    ♪ ♩ ♫
  </p>

  <p class="clear-message">
    <span class="song-line">
      「<span class="clear-song-title"><%= @song_title %></span>」
    </span>

    <span class="remember-line">
      を少し覚えました！
    </span>
  </p>

  <div class="clear-visual">
    <%= image_tag "nekotoonpu.png", alt: "猫と音符のイラスト" %>
  </div>


  <div class="back-link-top">
    <%= link_to "曲選択画面に戻る", learns_path %>
  </div>

  <div class="back-link">
    <%= link_to "トップに戻る", root_path %>
  </div>

</div>

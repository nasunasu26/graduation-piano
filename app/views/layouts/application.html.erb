<!DOCTYPE html>
<html>
  <head>
    <title>キラクナピアノ | ログインなしで弾ける無料ピアノアプリ</title>
    
    <meta
      name="description"
      content="キラクナピアノは、ログインなし・インストールなしで、すぐに弾ける無料ピアノアプリです。ブラウザ上で気軽にピアノ演奏や曲の練習が楽しめます。"
    >

    <meta name="google-site-verification" content="qrIZ4TPhgb_0-XomSp-FmyxWCjOMvSkyRECo5kVzvoI" />

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Kaisei+Decol&display=swap"
      rel="stylesheet"
    >

    <%= favicon_link_tag "favicon.ico" %>

  </head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-Q8YZJ8V3RJ"></script>
  <script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-Q8YZJ8V3RJ');
  </script>

  <body>
    <header class="site-header">

      <div class="header-inner">

        <%= image_tag "logo2.png", class: "site-logo" %>

        <div class="site-title">
          キラクナピアノ
        </div>

      </div>

    </header>

    <%= yield %>

    <footer class="site-footer">
      <p>キラクナピアノ | ログインなしで弾ける無料ピアノアプリ</p>
    </footer>

  </body>

</html>
